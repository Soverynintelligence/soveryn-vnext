#!/usr/bin/env bash
# Local-only Aider against the SOVERYN house routers.
# Default: Blackwell router :8090, model alias "aetheria" (Qwen3.8-27B as of 2026-08-17).
#
# Usage:
#   soveryn-aider                    # current dir, aetheria @ 8090
#   soveryn-aider --kernel           # Kernel Flash-Next on 127.0.0.1:8888 + persona
#   soveryn-aider --flash            # same as --kernel
#   soveryn-aider --model openai/vett-scotty
#   soveryn-aider path/to/file.py
#
# Nothing leaves the machine unless you change AIDER_BASE to a cloud URL.

set -euo pipefail

AIDER_BIN="${AIDER_BIN:-$HOME/.venvs/aider/bin/aider}"
if [[ ! -x "$AIDER_BIN" ]]; then
  AIDER_BIN="${HOME}/miniconda3/envs/soveryn/bin/aider"
fi
if [[ ! -x "$AIDER_BIN" ]]; then
  echo "aider not found. Install: $HOME/.venvs/aider/bin/pip install aider-chat" >&2
  exit 1
fi

KERNEL_SOUL="${KERNEL_SOUL:-$HOME/soveryn_vnext/data/memory/souls/kernel.md}"
EXTRA_READ=()

ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--kernel" || "$arg" == "--flash" ]]; then
    # Follow the ACTIVE house brain (2026-09-19 fix). This used to hardcode
    # Flash-Next @ :8888; after GLM took over the Sparks (2026-09-13), every
    # overnight kernel job spun aider against the parked endpoint for hours —
    # two weeks of dead-CPU churn (~46% of a core per night). Now: read
    # ~/.soveryn/kernel_brain, aim at the live endpoint, and FAIL FAST if the
    # model is not actually serving. Never assume; probe.
    BRAIN=$(cat "$HOME/.soveryn/kernel_brain" 2>/dev/null || echo flash)
    case "$BRAIN" in
      glm)
        export AIDER_BASE="${AIDER_BASE:-http://10.10.10.2:8001/v1}"
        export AIDER_MODEL="${AIDER_MODEL:-openai/glm-5.3-flash}"
        ;;
      aetheria|qwen)
        export AIDER_BASE="${AIDER_BASE:-http://127.0.0.1:8090/v1}"
        export AIDER_MODEL="${AIDER_MODEL:-openai/aetheria}"
        ;;
      *)
        export AIDER_BASE="${AIDER_BASE:-http://127.0.0.1:8888/v1}"
        export AIDER_MODEL="${AIDER_MODEL:-openai/qwen3.8-flash-next}"
        ;;
    esac
    # Liveness probe: the endpoint must list the model BEFORE aider starts.
    MODEL_NAME="${AIDER_MODEL#openai/}"
    if ! curl -fsS --max-time 10 "${AIDER_BASE%/}/models" 2>/dev/null \
         | grep -q "\"$MODEL_NAME\""; then
      echo "soveryn-aider: REFUSING to start — $MODEL_NAME is not serving at $AIDER_BASE" >&2
      echo "soveryn-aider: the active brain is '$BRAIN'. Start that serve, or run" >&2
      echo "soveryn-aider:   kernel status   to see what is actually live." >&2
      exit 2
    fi
    echo "soveryn-aider: using Kernel ($MODEL_NAME) @ ${AIDER_BASE}" >&2
    # Headless: --yes is an alias for --yes-always. Without
    # --no-show-model-warnings, GLM's unknown-context warning opens a docs
    # URL prompt; empty stdin takes [Yes] and Aider then auto-adds every
    # markdown path mentioned in README (the 2026-08-31 Kernel docs-pass stall).
    export AIDER_SHOW_MODEL_WARNINGS=false
    export AIDER_DETECT_URLS=false
    export AIDER_YES_ALWAYS=true
    export AIDER_AUTO_LINT=false
    ARGS+=(--yes-always --no-show-model-warnings --no-browser --no-detect-urls --no-auto-lint --map-tokens 0)
    if [[ -f "$KERNEL_SOUL" ]]; then
      EXTRA_READ+=(--read "$KERNEL_SOUL")
      echo "soveryn-aider: loading Kernel persona from $KERNEL_SOUL" >&2
    else
      echo "soveryn-aider: WARN — Kernel soul missing at $KERNEL_SOUL" >&2
    fi
  else
    ARGS+=("$arg")
  fi
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

export OPENAI_API_BASE="${AIDER_BASE:-http://127.0.0.1:8090/v1}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-local}"

DEFAULT_MODEL="${AIDER_MODEL:-openai/aetheria}"

exec "$AIDER_BIN" \
  --model "$DEFAULT_MODEL" \
  --no-auto-commits \
  --no-gitignore \
  "${EXTRA_READ[@]+"${EXTRA_READ[@]}"}" \
  "$@"

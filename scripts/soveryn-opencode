#!/usr/bin/env bash
# Kernel via OpenCode.
# Default coding brain: DeepSeek V4 Flash on Quadros :8091 (better long-repo feel).
# Optional large-ctx / speed lane: Qwen 3.8 on Blackwell :8090 — pass --qwen.
# Aider surgical fallback:
#   soveryn-aider --kernel   # Flash @ :8091
#   soveryn-aider            # Qwen / aetheria @ :8090
#
# Usage:
#   soveryn-opencode                         # TUI, Kernel agent, Flash
#   soveryn-opencode --qwen                  # TUI on Qwen instead (49k ctx lane)
#   soveryn-opencode --flash                 # explicit Flash (same as default)
#   soveryn-opencode /path/to/repo           # TUI in that project
#   soveryn-opencode run "mend X"            # headless one-shot (Flash)
#   soveryn-opencode run --auto "…"          # auto-approve non-denied perms
#
# Note: Flash preset is ctx-size 16384 today — precise greps beat blind hunts.
# Nothing leaves the machine unless you change the provider baseURL.

set -euo pipefail

OPENCODE_BIN="${OPENCODE_BIN:-$HOME/.opencode/bin/opencode}"
if [[ ! -x "$OPENCODE_BIN" ]]; then
  OPENCODE_BIN="$(command -v opencode 2>/dev/null || true)"
fi
if [[ -z "${OPENCODE_BIN}" || ! -x "$OPENCODE_BIN" ]]; then
  echo "opencode not found. Install: curl -fsSL https://opencode.ai/install | bash" >&2
  exit 1
fi

CFG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/soveryn_vnext/config/opencode}"
CFG_FILE="${OPENCODE_CONFIG:-$CFG_DIR/opencode.json}"
if [[ ! -f "$CFG_FILE" ]]; then
  echo "soveryn-opencode: missing config at $CFG_FILE" >&2
  exit 1
fi

export OPENCODE_CONFIG="$CFG_FILE"
export OPENCODE_CONFIG_DIR="$CFG_DIR"
export OPENAI_API_KEY="${OPENAI_API_KEY:-sk-local-soveryn}"

# Parse --qwen / --flash; strip before forwarding to opencode
USE_QWEN=0
ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--qwen" ]]; then
    USE_QWEN=1
  elif [[ "$arg" == "--flash" ]]; then
    USE_QWEN=0
  else
    ARGS+=("$arg")
  fi
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

if [[ "$USE_QWEN" -eq 1 ]]; then
  MODEL="kernel-qwen/aetheria"
  CHECK_URL="http://127.0.0.1:8090/v1/models"
  LABEL="Kernel · Qwen 3.8 large-ctx @ http://127.0.0.1:8090/v1"
else
  MODEL="kernel-flash/bench-flash"
  CHECK_URL="http://127.0.0.1:8091/v1/models"
  LABEL="Kernel · Flash coding @ http://127.0.0.1:8091/v1"
fi

if ! curl -sf --max-time 2 "$CHECK_URL" >/dev/null; then
  echo "soveryn-opencode: WARN — $CHECK_URL not answering; warm the brain first" >&2
fi

echo "soveryn-opencode: $LABEL" >&2
echo "soveryn-opencode: config $CFG_FILE" >&2

HAS_AGENT=0
HAS_MODEL=0
SUB=""
if [[ ${#ARGS[@]} -gt 0 ]]; then
  case "${ARGS[0]}" in
    run|attach|serve|web|models|agent|providers|auth|mcp|session|stats|upgrade|uninstall|debug|completion|acp|github|pr|plugin|db|export|import)
      SUB="${ARGS[0]}"
      ;;
  esac
fi
for a in "${ARGS[@]+"${ARGS[@]}"}"; do
  [[ "$a" == "--agent" || "$a" == --agent=* ]] && HAS_AGENT=1
  [[ "$a" == "--model" || "$a" == --model=* || "$a" == "-m" ]] && HAS_MODEL=1
done

EXTRA=()
if [[ "$SUB" == "run" ]]; then
  [[ $HAS_AGENT -eq 0 ]] && EXTRA+=(--agent kernel)
  [[ $HAS_MODEL -eq 0 ]] && EXTRA+=(--model "$MODEL")
elif [[ -z "$SUB" ]]; then
  [[ $HAS_MODEL -eq 0 ]] && EXTRA+=(--model "$MODEL")
fi

exec "$OPENCODE_BIN" "${EXTRA[@]+"${EXTRA[@]}"}" "${ARGS[@]+"${ARGS[@]}"}"

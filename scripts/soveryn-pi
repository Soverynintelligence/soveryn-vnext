#!/usr/bin/env bash
# Kernel via Pi (Mario Zechner / earendil). Brain switcher → Flash / GLM / Aetheria.
# Profiles SSOT: config/soveryn-cli/profiles.json (symlinked at config/pi/profiles.json).
# Regenerates config/pi/models.json + settings.json from the active profile.
#
# Usage:
#   kernel | soveryn-pi              # TUI, active brain (default flash)
#   kernel use flash|aetheria        # persist active brain
#   kernel use glm                   # REFUSES if parked (never silent flash)
#   kernel model                     # interactive picker
#   kernel status                    # brain + health + endpoint
#   kernel --flash / --glm / --qwen|--aetheria / --profile NAME
#   kernel --high / --build / --offline / --online
#   kernel /path/to/repo
#   kernel -p "mend X"
#
# Active brain files (kept in sync):
#   ~/.soveryn/kernel_brain
#   ~/.soveryn/soveryn-cli-profile
#
# Default: ONLINE. Thinking off for flash.
# Park/unpark: kernel unpark glm [--confirm|--if-healthy|--dry-run]; kernel park glm [--confirm]
# GLM unpark is owner-gated (stops Flash-Next). Prefer --if-healthy when :8001 already live.

set -euo pipefail

REPO="${SOVERYN_VNEXT:-$HOME/soveryn_vnext}"
CLI_JS="${REPO}/packages/soveryn-cli/src/cli.js"
if [[ ! -f "$CLI_JS" ]]; then
  echo "soveryn-pi: missing $CLI_JS" >&2
  exit 1
fi

# Kernel always owns config/pi (ignore ambient SOVERYN_CLI_DIR from soveryn-cli).
KERNEL_CFG="${SOVERYN_KERNEL_DIR:-$REPO/config/pi}"

export SOVERYN_HARNESS=kernel
export SOVERYN_VNEXT="$REPO"
export SOVERYN_CLI_DIR="$KERNEL_CFG"
export PI_CODING_AGENT_DIR="$KERNEL_CFG"
export KERNEL_LATTICE="${KERNEL_LATTICE:-1}"
export KERNEL_MEMORY="${KERNEL_MEMORY:-1}"

# Octen (Pi HTTP tools in config/pi/extensions/octen.ts). Prefer env already set;
# else pull ONLY OCTEN_API_KEY from gitignored $REPO/.env — never echo the value.
if [[ -z "${OCTEN_API_KEY:-}" && -f "$REPO/.env" ]]; then
  _octen_line="$(grep -E '^[[:space:]]*OCTEN_API_KEY=' "$REPO/.env" | tail -n1 || true)"
  if [[ -n "${_octen_line}" ]]; then
    _octen_val="${_octen_line#OCTEN_API_KEY=}"
    _octen_val="${_octen_val#$'\r'}"
    if [[ "${_octen_val}" == \"*\" ]]; then _octen_val="${_octen_val:1:-1}"; fi
    if [[ "${_octen_val}" == \'*\' ]]; then _octen_val="${_octen_val:1:-1}"; fi
    export OCTEN_API_KEY="${_octen_val}"
    unset _octen_val
  fi
  unset _octen_line
fi
export SOVERYN_PROFILES_PATH="${SOVERYN_PROFILES_PATH:-$REPO/config/soveryn-cli/profiles.json}"
export SOVERYN_CLI_PROFILE_FILE="${SOVERYN_CLI_PROFILE_FILE:-$HOME/.soveryn/kernel_brain}"

NODE_BIN="${NODE_BIN:-}"
if [[ -z "$NODE_BIN" ]]; then
  NODE_BIN="$(command -v node 2>/dev/null || true)"
fi
if [[ -z "$NODE_BIN" || ! -x "$NODE_BIN" ]]; then
  echo "soveryn-pi: node not found on PATH" >&2
  exit 1
fi

exec "$NODE_BIN" "$CLI_JS" "$@"

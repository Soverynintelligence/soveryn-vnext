# SOVERYN orchestration target — user session bring-up.

[Unit]
Description=SOVERYN all-up orchestration target
Wants=soveryn-router.service soveryn-vnext.service soveryn-ares.service
After=soveryn-router.service soveryn-vnext.service soveryn-ares.service
AllowIsolate=yes

[Install]
WantedBy=default.target

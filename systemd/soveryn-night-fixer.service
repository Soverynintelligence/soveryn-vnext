[Unit]
Description=SOVERYN night fixer — known-failing tests become dispatched tasks (worker + acceptance gate; merges stay gated)
After=soveryn-vnext.service

[Service]
Environment=SOVERYN_ROOT=%h/soveryn_vnext
Type=oneshot
WorkingDirectory=%h/soveryn_vnext
ExecStart=/home/jon-deoliveira/miniconda3/envs/soveryn/bin/python %h/soveryn_vnext/scripts/night_fixer.py
TimeoutStartSec=1200

[Install]
WantedBy=soveryn.target

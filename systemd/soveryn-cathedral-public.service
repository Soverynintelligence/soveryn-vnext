# SOVERYN Cathedral public face — user service.
# Same galaxy as /cathedral on :5001, with memory text stripped at the API.
# Fronted by the pondwright cloudflared tunnel (cathedral.soverynintelligence.com).

[Unit]
Description=SOVERYN Cathedral public face (:18810, text redacted)
PartOf=soveryn.target
After=soveryn-vnext.service

[Service]
Environment=SOVERYN_ROOT=%h/soveryn_vnext
Type=simple
WorkingDirectory=%h/soveryn_vnext
ExecStart=/home/jon-deoliveira/miniconda3/envs/soveryn/bin/python -m soveryn.app.public_cathedral
Restart=on-failure
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=soveryn.target

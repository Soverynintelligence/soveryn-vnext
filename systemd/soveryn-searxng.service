# SOVERYN SearXNG metasearch — user service.
# Self-hosted privacy-respecting search backend for Aetheria + Vett web tools.
# Bound to 127.0.0.1:8095 only — no external exposure.
#
# Settings: %h/soveryn_vnext/config/searxng/settings.yml
# Secret:   %h/.config/soveryn/searxng.env  (SEARXNG_SECRET_KEY) — not in git

[Unit]
Description=SOVERYN SearXNG metasearch (:8095)
After=network.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/soveryn/searxng.env
ExecStartPre=-/usr/bin/docker rm -f soveryn-searxng
ExecStart=/usr/bin/docker run --rm --name soveryn-searxng \
  -p 127.0.0.1:8095:8080 \
  -v %h/soveryn_vnext/config/searxng:/etc/searxng \
  -e BASE_URL=http://127.0.0.1:8095/ \
  -e INSTANCE_NAME=soveryn-searxng \
  -e SEARXNG_SECRET_KEY=${SEARXNG_SECRET_KEY} \
  searxng/searxng:latest
ExecStop=/usr/bin/docker stop soveryn-searxng
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=soveryn.target

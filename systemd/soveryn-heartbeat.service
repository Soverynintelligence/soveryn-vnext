# SOVERYN heartbeat unit — AetheriaAutonomy autonomous cycle.
# python -m soveryn.agents.heartbeat

[Unit]
Description=SOVERYN heartbeat (AetheriaAutonomy cycle)
PartOf=soveryn.target
After=soveryn-vnext.service network-online.target
Wants=network-online.target

[Service]
Environment=SOVERYN_ROOT=%h/soveryn_vnext
Type=simple
WorkingDirectory=%h/soveryn_vnext
Environment=PATH=/home/jon-deoliveira/miniconda3/envs/soveryn/bin:/usr/bin
ExecStartPre=/home/jon-deoliveira/miniconda3/envs/soveryn/bin/python -m soveryn.platform.supervisor.readiness http://127.0.0.1:5001/health --name vnext --max-wait 60
ExecStart=/home/jon-deoliveira/miniconda3/envs/soveryn/bin/python -m soveryn.agents.heartbeat
Restart=on-failure
RestartSec=15s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=soveryn.target

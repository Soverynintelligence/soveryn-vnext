# SOVERYN vNext app unit — user service.
# Waits for router /props before starting the Flask app.

[Unit]
Description=SOVERYN vNext Flask app on :5001 (chat / streaming / tools)
Documentation=https://github.com/anthropics/claude-code
PartOf=soveryn.target
After=soveryn-router.service network-online.target
Requires=soveryn-router.service
Wants=parakeet.service network-online.target

[Service]
Type=simple
User=jon-deoliveira
WorkingDirectory=/home/jon-deoliveira/soveryn_vnext
Environment=PATH=/home/jon-deoliveira/miniconda3/envs/soveryn/bin:/usr/bin SOVERYN_APP_PORT=5001
# Block until the router's /props endpoint reports ok (up to 60s).
# If the router isn't ready, ExecStart never fires and systemd marks
# this unit failed — Restart=on-failure picks it up after RestartSec.
ExecStartPre=/home/jon-deoliveira/miniconda3/envs/soveryn/bin/python -m soveryn.platform.supervisor.readiness http://127.0.0.1:8090/props --name router --max-wait 60
ExecStart=/home/jon-deoliveira/miniconda3/envs/soveryn/bin/python -m soveryn.app
Restart=on-failure
RestartSec=5s
StandardOutput=append:/tmp/soveryn-vnext.log
StandardError=append:/tmp/soveryn-vnext.log

[Install]
WantedBy=soveryn.target

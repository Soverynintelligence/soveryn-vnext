# SOVERYN vNext app unit — user service.
# Waits for router /props before starting the Flask app.

[Unit]
Description=SOVERYN vNext Flask app (:5001)
After=soveryn-router.service
Requires=soveryn-router.service

[Service]
Type=simple
User=jon-deoliveira
WorkingDirectory=/home/jon-deoliveira/soveryn_vnext
Environment=SOVERYN_APP_PORT=5001
ExecStartPre=/home/jon-deoliveira/miniconda3/envs/soveryn/bin/python -m soveryn.platform.supervisor.readiness http://127.0.0.1:8090/props --name router --max-wait 180
ExecStart=/home/jon-deoliveira/miniconda3/envs/soveryn/bin/python -m soveryn.app
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=soveryn.target

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Delegation: Scotty's throwaway execution worktrees (created under
# .worktrees/<task_id> by the delegation engine; never committed).
.worktrees/

# Virtualenvs
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*~

# Runtime
*.log

# Superpowers brainstorm session content (ephemeral)
.superpowers/
# Runtime data stores — live state, not artifacts
data/lattice/*.db*
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/ares/
data/telemetry/
# Conversation + lattice DBs, pinned memory, salience, .migrated markers.
# Souls/ IS tracked (character config) — kept via the negation below.
# Exclude the CONTENTS, not the directory: git will not descend into an
# excluded directory, so `data/memory/` made the souls negations below
# unreachable. aetheria.origin.md was silently untracked because of it.
data/memory/*
!data/memory/souls/
!data/memory/souls/**
data/aetheria_heartbeat_thoughts*
data/heartbeat_deploy_started_at
data/black_box/
data/sandbox/
data/steward/
data/subconscious/
data/voice/
data/templates_legacy/
data/router-presets.ini

# Eval stderr capture (debug noise; .json artifacts stay committed)
eval_runs/*.stderr

# Local environment secrets
.env
.env.local
.env.*.local

# Runtime data backups (created by scripts/backup_soveryn.sh — large, local-only)
backups/

# Thermal samples: a couple of MB a month of machine readings, regenerated
# continuously. The collector is code and belongs in git; the log does not.
data/thermal/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Delegation: Scotty's throwaway execution worktrees (created under
# .worktrees/<task_id> by the delegation engine; never committed).
.worktrees/

# Virtualenvs
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*~

# Runtime
*.log

# Superpowers brainstorm session content (ephemeral)
.superpowers/
# Runtime data stores — live state, not artifacts
data/lattice/*.db*
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/ares/
data/telemetry/
# Conversation + lattice DBs, pinned memory, salience, .migrated markers.
# Souls/ IS tracked (character config) — kept via the negation below.
# Exclude the CONTENTS, not the directory: git will not descend into an
# excluded directory, so `data/memory/` made the souls negations below
# unreachable. aetheria.origin.md was silently untracked because of it.
data/memory/*
!data/memory/souls/
!data/memory/souls/**
!data/memory/skills/
!data/memory/skills/**
data/aetheria_heartbeat_thoughts*
data/heartbeat_deploy_started_at
data/black_box/
data/sandbox/
data/steward/
data/subconscious/
data/voice/
data/templates_legacy/
data/router-presets.ini

# Eval stderr capture (debug noise; .json artifacts stay committed)
eval_runs/*.stderr

# Eve CWG Instagram desk — session cookies, not git
data/eve_ig_profile/
# Per-agent browser desks (Google Ads/Business, etc.) — cookies, not git
data/desks/

# Local environment secrets
.env
.env.local
.env.*.local

# Runtime data backups (created by scripts/backup_soveryn.sh — large, local-only)
backups/

# Thermal samples: a couple of MB a month of machine readings, regenerated
# continuously. The collector is code and belongs in git; the log does not.
data/thermal/

# Operational noise (medic, watchdog, X capture, heartbeat) — live state only
data/medic/
data/watchdog/
data/surfaces/
data/xid_captures/
data/x_daily_post_state.json
data/x_rejections.jsonl
data/heartbeat_thoughts.jsonl
data/ops/

# Local scratch, Cloudflare wrangler cache, backup copies of configs
scratch/
.wrangler/
*.bak
*.bak-*
**/*.bak
**/*.bak-*
runtime/*.bak*
soveryn/config/*.bak*

# ActTruth / Continuum / Kernel HITL live ledgers (regenerated)
data/acttruth/
data/automations/
data/media/
data/continuum/
data/kernel_proposals/

# Local bake / spike scratch
tmp/

# OpenCode local install deps (config + plugins are tracked)
config/opencode/node_modules/

# Package build artifacts
packages/*/build/
packages/*/dist/

# PondWright / AKT secrets live under ~/.config/soveryn/

# Runtime group-room sidecars (not source)
data/rooms/

# Canva Connect OAuth tokens (never commit)
data/canva/

# Google Business Profile OAuth tokens (never commit)
data/gbp/

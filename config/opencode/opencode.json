{
  "$schema": "https://opencode.ai/config.json",
  "model": "kernel-glm/glm-5.3-flash",
  "small_model": "kernel-glm/glm-5.3-flash",
  "enabled_providers": ["kernel-glm", "kernel-qwen"],
  "provider": {
    "kernel-glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kernel coding · GLM-5.3-Flash dual Spark (:8001)",
      "options": {
        "baseURL": "http://10.10.10.2:8001/v1",
        "apiKey": "local",
        "chat_template_kwargs": {
          "enable_thinking": false,
          "thinking": false
        }
      },
      "models": {
        "glm-5.3-flash": {
          "name": "Kernel · GLM-5.3-Flash NVFP4 TP=2 (OpenCode default)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "kernel-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kernel alt · Qwen 3.8 (:8090)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local"
      },
      "models": {
        "aetheria": {
          "name": "Kernel · Qwen 3.8 (large-ctx / speed lane)",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "kernel": {
      "description": "SOVERYN house build brain — autonomous mend/patch on GLM-5.3-Flash",
      "mode": "primary",
      "model": "kernel-glm/glm-5.3-flash",
      "temperature": 0.2,
      "prompt": "{file:./agents/kernel.md}",
      "color": "#6aa84f",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "rm -rf *": "deny",
          "sudo *": "ask",
          "git push*": "ask",
          "git push --force*": "deny"
        },
        "external_directory": "ask",
        "webfetch": "ask",
        "websearch": "ask"
      }
    },
    "build": {
      "model": "kernel-glm/glm-5.3-flash"
    },
    "plan": {
      "model": "kernel-glm/glm-5.3-flash"
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git push --force*": "deny"
    },
    "external_directory": "ask"
  }
}

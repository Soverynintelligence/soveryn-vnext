{
  "$schema": "https://opencode.ai/config.json",
  "model": "kernel-flash/bench-flash",
  "small_model": "kernel-flash/bench-flash",
  "enabled_providers": ["kernel-flash", "kernel-qwen"],
  "provider": {
    "kernel-flash": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kernel coding · DeepSeek Flash (:8091)",
      "options": {
        "baseURL": "http://127.0.0.1:8091/v1",
        "apiKey": "sk-local-soveryn"
      },
      "models": {
        "bench-flash": {
          "name": "Kernel · DeepSeek V4 Flash (OpenCode default)",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    },
    "kernel-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kernel alt · Qwen 3.8 (:8090)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "sk-local-soveryn"
      },
      "models": {
        "aetheria": {
          "name": "Kernel · Qwen 3.8 (large-ctx / speed lane)",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "kernel": {
      "description": "SOVERYN house build brain — autonomous mend/patch on DeepSeek Flash",
      "mode": "primary",
      "model": "kernel-flash/bench-flash",
      "temperature": 0.2,
      "prompt": "{file:./agents/kernel.md}",
      "color": "#6aa84f",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "rm -rf *": "deny",
          "sudo *": "ask",
          "git push*": "ask",
          "git push --force*": "deny"
        },
        "external_directory": "ask",
        "webfetch": "ask",
        "websearch": "ask"
      }
    },
    "build": {
      "model": "kernel-flash/bench-flash"
    },
    "plan": {
      "model": "kernel-flash/bench-flash"
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git push --force*": "deny"
    },
    "external_directory": "ask"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "model": "soveryn/coding",
  "small_model": "soveryn/coding",
  "enabled_providers": [
    "soveryn",
    "kernel-qwen"
  ],
  "provider": {
    "soveryn": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SOVERYN coding harness \u00b7 Flash-Next :8888",
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1",
        "apiKey": "local",
        "chat_template_kwargs": {
          "enable_thinking": false
        },
        "extraBody": {
          "chat_template_kwargs": {
            "enable_thinking": false
          }
        }
      },
      "models": {
        "coding": {
          "id": "qwen3.8-flash-next",
          "name": "SOVERYN coding \u00b7 Qwen3.8-Flash-Next NVFP4 TP=1 spark2",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen3.8-flash-next": {
          "name": "SOVERYN \u00b7 Qwen3.8-Flash-Next (direct id)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    },
    "kernel-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kernel alt \u00b7 Qwen 3.8 (:8090)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local"
      },
      "models": {
        "aetheria": {
          "name": "Kernel \u00b7 Qwen 3.8 (large-ctx / speed lane)",
          "limit": {
            "context": 49152,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "kernel": {
      "description": "SOVERYN house build brain \u2014 Week1 Flash-Next harness",
      "mode": "primary",
      "model": "soveryn/coding",
      "temperature": 0.2,
      "prompt": "{file:./agents/kernel.md}",
      "color": "#6aa84f",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "rm -rf *": "deny",
          "sudo *": "ask",
          "git push*": "ask",
          "git push --force*": "deny"
        },
        "external_directory": "ask",
        "webfetch": "ask",
        "websearch": "ask"
      }
    },
    "build": {
      "model": "soveryn/coding"
    },
    "plan": {
      "model": "soveryn/coding"
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git push --force*": "deny"
    },
    "external_directory": "ask"
  },
  "_rollback_note": "Week1 2026-09-09: provider kernel-glm renamed to soveryn; alias soveryn/coding \u2192 upstream qwen3.8-flash-next via model.id. GLM :8001 parked (bak-20260906-glm-tp2 + bak-20260909-week1-pre). Tunnel: soveryn-spark2-flashnext-8888.service. Thinking forced off via chat_template_kwargs.enable_thinking=false."
}

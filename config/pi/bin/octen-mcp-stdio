#!/usr/bin/env bash
# Optional stdio MCP launcher for Octen. Pi core cannot speak MCP;
# use only if a Pi MCP adapter extension is installed later.
# Loads OCTEN_API_KEY from env or gitignored soveryn_vnext/.env — never prints it.
set -euo pipefail
REPO="${SOVERYN_VNEXT:-$HOME/soveryn_vnext}"
if [[ -z "${OCTEN_API_KEY:-}" && -f "$REPO/.env" ]]; then
  _line="$(grep -E '^[[:space:]]*OCTEN_API_KEY=' "$REPO/.env" | tail -n1 || true)"
  if [[ -n "${_line}" ]]; then
    _val="${_line#OCTEN_API_KEY=}"
    _val="${_val#$'\r'}"
    [[ "${_val}" == \"*\" ]] && _val="${_val:1:-1}"
    [[ "${_val}" == \'*\' ]] && _val="${_val:1:-1}"
    export OCTEN_API_KEY="${_val}"
    unset _val
  fi
  unset _line
fi
if [[ -z "${OCTEN_API_KEY:-}" ]]; then
  echo "octen-mcp-stdio: OCTEN_API_KEY missing (env or $REPO/.env)" >&2
  exit 1
fi
exec npx -y octen-mcp@0.5.2

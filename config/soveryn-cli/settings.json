{
  "defaultProvider": "soveryn-deepseek",
  "defaultModel": "deepseek-v4.1-flash-1017",
  "defaultThinkingLevel": "off",
  "theme": "soveryn-lab",
  "quietStartup": false,
  "defaultProjectTrust": "always",
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32768
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0
    }
  },
  "httpIdleTimeoutMs": 600000,
  "lastChangelogVersion": "1.3.0",
  "extensions": [
    "-builtin:mcp"
  ],
  "tuiMode": "regular"
}
